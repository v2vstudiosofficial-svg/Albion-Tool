local Strings = {}
Strings.texts = texts

function Strings.has(key: string): boolean
	return texts[key] ~= nil
end

function Strings.get(key: string, ...: any): string
	local text = texts[key]
	if text == nil then
		return key
	end
	if select("#", ...) > 0 then
		return string.format(text, ...)
	end
	return text
end

return Strings
